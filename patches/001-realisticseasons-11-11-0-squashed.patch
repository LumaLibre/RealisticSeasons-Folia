+
+    public static ScheduledTask runAsyncRepeating(Runnable runnable, long delay, long period) {
+        return INSTANCE.getServer().getAsyncScheduler().runAtFixedRate(INSTANCE, t -> runnable.run(), Math.max(delay * 50L, MIN_DELAY), Math.max(period * 50L, MIN_DELAY), TimeUnit.MILLISECONDS);
+    }
