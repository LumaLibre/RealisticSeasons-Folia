+    }
+
+
+    private static boolean checkFolia() {
+        try {
+            Class.forName("io.papermc.paper.threadedregions.RegionizedServer");
+            return true;
+        } catch (ClassNotFoundException ignored) {
+            return false;
+        }
+    }
+
+    public abstract static class RealisticSeasonsTask {
+
+        @MonotonicNonNull
+        private ScheduledTask task = null;
+
+
+        protected abstract void consume(ScheduledTask task);
+
+
+        public ScheduledTask runAsync() {
+            this.task = Scheduler.runAsync(this::consume);
+            return this.task;
+        }
+
+        public ScheduledTask runSync(Location location) {
+            this.task = Scheduler.runSync(location, this::consume);
+            return this.task;
+        }
+
+        public ScheduledTask runSync(Entity entity) {
+            this.task = Scheduler.runSync(entity, this::consume);
+            return this.task;
+        }
+
+        public ScheduledTask runSync(Chunk chunk) {
+            this.task = Scheduler.runSync(chunk, this::consume);
+            return this.task;
+        }
+
+        public ScheduledTask runAsyncDelayed(long delay) {
+            this.task = Scheduler.runAsyncDelayed(this::consume, delay);
+            return this.task;
+        }
+
+        public ScheduledTask runSyncDelayed(Location location, long delay) {
+            this.task = Scheduler.runSyncDelayed(location, this::consume, delay);
+            return this.task;
+        }
+
+        public ScheduledTask runSyncDelayed(Entity entity, long delay) {
+            this.task = Scheduler.runSyncDelayed(entity, this::consume, delay);
+            return this.task;
+        }
+
+        public ScheduledTask runSyncDelayed(Chunk chunk, long delay) {
+            this.task = Scheduler.runSyncDelayed(chunk, this::consume, delay);
+            return this.task;
+        }
+
+
+        public ScheduledTask runAsyncRepeating(long delay, long period) {
+            this.task = Scheduler.runAsyncRepeating(this::consume, delay, period);
+            return this.task;
+        }
+
+        public ScheduledTask runSyncRepeating(Location location, long delay, long period) {
+            this.task = Scheduler.runSyncRepeating(location, this::consume, delay, period);
+            return this.task;
+        }
+
+        public ScheduledTask runSyncRepeating(Entity entity, long delay, long period) {
+            this.task = Scheduler.runSyncRepeating(entity, this::consume, delay, period);
+            return this.task;
+        }
+
+        public ScheduledTask runSyncRepeating(Chunk chunk, long delay, long period) {
+            this.task = Scheduler.runSyncRepeating(chunk, this::consume, delay, period);
+            return this.task;
+        }
+
+        public ScheduledTask runGlobal() {
+            this.task = Scheduler.runGlobal(this::consume);
+            return this.task;
+        }
+
+        public ScheduledTask runGlobalDelayed(long delay) {
+            this.task = Scheduler.runGlobalDelayed(this::consume, delay);
+            return this.task;
+        }
+
+
+        public ScheduledTask runGlobalRepeating(long delay, long period) {
+            this.task = Scheduler.runGlobalRepeating(this::consume, delay, period);
+            return this.task;
+        }
+
+
+        public void cancel() {
+            Preconditions.checkNotNull(this.task, "Task has not been scheduled yet!");
+            this.task.cancel();
+        }
+
+        public boolean isCancelled() {
+            Preconditions.checkNotNull(this.task, "Task has not been scheduled yet!");
+            return this.task.isCancelled();
+        }
+    }
+}
