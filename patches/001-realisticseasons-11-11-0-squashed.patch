+    }
+
+    public static ScheduledTask runAsyncRepeating(Consumer<ScheduledTask> task, long delay, long period) {
+        return INSTANCE.getServer().getAsyncScheduler().runAtFixedRate(INSTANCE, task, Math.max(delay * 50L, MIN_DELAY), Math.max(period * 50L, MIN_DELAY), TimeUnit.MILLISECONDS);
+    }
+
+    public static ScheduledTask runSync(Location location, Consumer<ScheduledTask> task) {
+        return INSTANCE.getServer().getRegionScheduler().run(INSTANCE, location, task);
+    }
+
+    public static ScheduledTask runSync(Entity entity, Consumer<ScheduledTask> task) {
+        return entity.getScheduler().run(INSTANCE, task, null);
+    }
+
+    public static ScheduledTask runSync(Chunk chunk, Consumer<ScheduledTask> task) {
+        return INSTANCE.getServer().getRegionScheduler().run(INSTANCE, chunk.getWorld(), chunk.getX(), chunk.getZ(), task);
