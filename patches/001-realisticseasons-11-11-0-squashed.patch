+    public static ScheduledTask runSync(Location location, Runnable runnable) {
+        return INSTANCE.getServer().getRegionScheduler().run(INSTANCE, location, t -> runnable.run());
+    }
+
+    public static ScheduledTask runSync(Entity entity, Runnable runnable) {
+        return entity.getScheduler().run(INSTANCE, t -> runnable.run(), null);
+    }
+
+    public static ScheduledTask runSync(Chunk chunk, Runnable runnable) {
+        return INSTANCE.getServer().getRegionScheduler().run(INSTANCE, chunk.getWorld(), chunk.getX(), chunk.getZ(), t -> runnable.run());
+    }
+
+    public static ScheduledTask runSyncDelayed(Location location, Runnable runnable, long delay) {
+        return INSTANCE.getServer().getRegionScheduler().runDelayed(INSTANCE, location, t -> runnable.run(), Math.max(delay, MIN_DELAY));
+    }
+
+    public static ScheduledTask runSyncDelayed(Entity entity, Runnable runnable, long delay) {
