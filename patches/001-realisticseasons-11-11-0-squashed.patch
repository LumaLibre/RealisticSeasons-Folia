+    public static ScheduledTask runAsync(Runnable runnable) {
+        return INSTANCE.getServer().getAsyncScheduler().runNow(INSTANCE, t -> runnable.run());
+    }
+
+    public static ScheduledTask runAsyncDelayed(Runnable runnable, long delay) {
+        return INSTANCE.getServer().getAsyncScheduler().runDelayed(INSTANCE, t -> runnable.run(), Math.max(delay * 50L, MIN_DELAY), TimeUnit.MILLISECONDS);
